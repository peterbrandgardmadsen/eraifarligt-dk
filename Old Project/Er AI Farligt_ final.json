      "id": "4fcb7c1a-4329-4fbf-af7d-25e0e2a3f911",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "return {\n  json: {\n    rssText: $items().map(item => {\n      const title = item.json.title?.trim() || 'Uden titel';\n      const content = item.json.content?.trim()\n        || item.json.contentSnippet?.trim()\n        || item.json.description?.trim()\n        || 'Ingen indhold';\n      const source = item.json.link || 'Ukendt kilde';\n\n      return `• ${title}\\n${content}\\n(Kilde: ${source})`;\n    }).join('\\n\\n'),\n    sources: $items().length\n  }\n};\n"
      },

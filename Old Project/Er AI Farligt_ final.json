    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const formattedDate = new Date($json.dato).toLocaleDateString('da-DK', {\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric'\n});\n\n\nconst html = `<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>AI Verdict – ${formattedDate}</title>\n</head>\n<body style=\"font-family: Arial, sans-serif; max-width: 700px; margin: 0 auto; padding: 20px; line-height: 1.6; background-color: #f9f9f9; color: #333;\">\n  <article>\n    <header>\n      <h1 style=\"text-align: center;\">Er AI farligt?</h1>\n      <p style=\"text-align: center;\"><em>Senest opdateret: ${formattedDate}</em></p>\n    </header>\n    <section style=\"margin-top: 30px;\">\n      <p><strong>Bedømmelse:</strong> ${$json.bedømmelse}</p>\n      <p><strong>Forklaring:</strong><br>${$json.ræsonnement}</p>\n      <p><em>Kilder analyseret: ${$json.kilder}</em></p>\n    </section>\n    <footer style=\"margin-top: 40px; text-align: center;\">\n      <p style=\"font-size: 0.9em; color: #777;\">Denne side er genereret automatisk af en n8n workflow, og bør ikke betragtes som pålidelig information.</p>\n    </footer>\n  </article>\n</body>\n</html>`;\n\nreturn {\n  json: {\n    html\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
